{
  "name": "insolver",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=@insolver/web",
    "api": "npm run start:dev --workspace=@insolver/api",
    "worker": "npm run start:dev --workspace=@insolver/worker",
    "seed": "npm run prisma:seed --workspace=@insolver/api",
    "seed:reset": "npm run db:reset --workspace=@insolver/api",
    "seed:large": "npm run seed:large --workspace=@insolver/api",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
